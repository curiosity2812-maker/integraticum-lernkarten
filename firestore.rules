rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userRole(uid) {
      let profile = /databases/$(database)/documents/users/$(uid);
      return exists(profile) ? get(profile).data.get('role', 'student') : 'student';
    }
    function role() {
      return signedIn() ? userRole(request.auth.uid) : 'student';
    }
    function teacher() {
      return role() in ['teacher', 'super_admin'];
    }
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }
    function ownsGroup(groupId) {
      return signedIn() && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.ownerUid == request.auth.uid;
    }
    function grantPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/teachers/$(uid);
    }
    function teachesGroup(groupId) {
      return role() == 'super_admin' || (teacher() && (ownsGroup(groupId)
        || (exists(groupPath(groupId)) && exists(grantPath(groupId, request.auth.uid)))));
    }
    function managesTeachers(groupId) {
      return role() == 'super_admin' || (teacher() && ownsGroup(groupId));
    }
    function membershipPath(groupId, uid) {
      return /databases/$(database)/documents/memberships/$(groupId + '_' + uid);
    }
    function isMember(groupId) {
      return signedIn() && exists(membershipPath(groupId, request.auth.uid));
    }
    function invitationPath(code) {
      return /databases/$(database)/documents/teacherInvitations/$(code);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || role() == 'super_admin');
      allow list: if role() == 'super_admin';
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','email','name'])
        && request.resource.data.role == 'student' && ownProfileIdentity();
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','name'])
          && ownProfileIdentity())
        || (role() == 'super_admin' && request.auth.uid != uid
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['student','teacher','super_admin']);

      function ownProfileIdentity() {
        return request.resource.data.email == request.auth.token.get('email','')
          && request.resource.data.name == request.auth.token.get('name','')
          && request.resource.data.email.size() <= 320 && request.resource.data.name.size() <= 150;
      }
    }
    match /groups/{groupId} {
      allow get, list: if signedIn();
      allow create: if teacher() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name','level','code','ownerUid','ownerName','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 90
        && request.resource.data.code is string && request.resource.data.code.size() <= 24;
      allow update, delete: if false;

      match /activity/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || role() == 'super_admin'
          || (teachesGroup(groupId) && exists(membershipPath(groupId, uid))));
        allow create, update: if signedIn() && request.auth.uid == uid && isMember(groupId)
          && validActivity();
      }

      match /teachers/{uid} {
        allow get: if teacher() && (request.auth.uid == uid || managesTeachers(groupId));
        allow list: if managesTeachers(groupId);
        allow create: if managesTeachers(groupId) && approvesInvitation(groupId, uid);
        allow create: if role() == 'super_admin' && exists(groupPath(groupId))
            && get(groupPath(groupId)).data.ownerUid != uid
            && userRole(uid) == 'teacher'
            && request.resource.data.keys().hasOnly(['assignedBy','createdAt'])
            && request.resource.data.assignedBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
        allow delete: if managesTeachers(groupId);

        function approvesInvitation(groupId, uid) {
          let grant = request.resource.data;
          let invite = invitationPath(grant.invitationCode);
          return grant.keys().hasOnly(['invitationCode', 'teacherEmail', 'createdAt'])
            && grant.createdAt == request.time && userRole(uid) == 'teacher'
            && exists(invite) && existsAfter(invite)
            && get(invite).data.status == 'pending'
            && get(invite).data.groupId == groupId
            && get(invite).data.teacherUid == uid
            && grant.teacherEmail == get(invite).data.teacherEmail
            && getAfter(invite).data.status == 'approved';
        }
      }
    }

    match /teacherInvitations/{code} {
      allow get: if teacher() && (resource.data.status == 'open'
        || resource.data.get('teacherUid', '') == request.auth.uid
        || managesTeachers(resource.data.groupId));
      allow list: if managesTeachers(resource.data.groupId);
      allow create: if managesTeachers(request.resource.data.groupId)
        && exists(groupPath(request.resource.data.groupId))
        && code.matches('^PREP-[0-9A-F]{24}$')
        && request.resource.data.keys().hasOnly(['groupId', 'status', 'createdAt'])
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if claimsInvitation() || resolvesInvitation();

      function claimsInvitation() {
        let groupId = resource.data.groupId;
        let updated = request.resource.data;
        return role() == 'teacher' && resource.data.status == 'open'
          && exists(groupPath(groupId)) && !ownsGroup(groupId)
          && !exists(grantPath(groupId, request.auth.uid))
          && updated.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'teacherUid', 'teacherEmail'])
          && updated.status == 'pending' && updated.teacherUid == request.auth.uid
          && updated.teacherEmail == request.auth.token.get('email', '');
      }
      function resolvesInvitation() {
        let groupId = resource.data.groupId;
        let updated = request.resource.data;
        return managesTeachers(groupId)
          && updated.diff(resource.data).affectedKeys().hasOnly(['status'])
          && ((resource.data.status in ['open', 'pending'] && updated.status == 'revoked')
            || (resource.data.status == 'pending' && updated.status == 'approved'
              && createsGrant(groupId, resource.data.teacherUid)));
      }
      function createsGrant(groupId, uid) {
        let grant = grantPath(groupId, uid);
        return !exists(grant) && existsAfter(grant)
          && getAfter(grant).data.invitationCode == code;
      }
    }

    match /joinRequests/{id} {
      allow get: if signedIn() && (id.matches('.*_' + request.auth.uid) || (resource != null && teachesGroup(resource.data.groupId)));
      allow list: if signedIn() && (resource.data.studentUid == request.auth.uid || teachesGroup(resource.data.groupId));
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid
        && id == request.resource.data.groupId + '_' + request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['groupId','studentUid','studentEmail','studentName','status','createdAt'])
        && request.resource.data.studentEmail == request.auth.token.get('email', '')
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 150
        && exists(groupPath(request.resource.data.groupId));
      allow update: if (signedIn() && resource.data.studentUid == request.auth.uid && resource.data.status in ['rejected','approved'] && !isMember(resource.data.groupId) && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) || (teachesGroup(resource.data.groupId) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'rejected'
          || (request.resource.data.status == 'approved'
            && existsAfter(membershipPath(resource.data.groupId, resource.data.studentUid)))));
    }
    match /memberships/{id} {
      allow get, list: if signedIn()
        && (resource.data.uid == request.auth.uid || teachesGroup(resource.data.groupId));
      allow create: if createsMembership();
      allow delete: if teachesGroup(resource.data.groupId);

      function createsMembership() {
        let member = request.resource.data;
        let application = /databases/$(database)/documents/joinRequests/$(id);
        return teachesGroup(member.groupId) && member.uid != request.auth.uid
          && id == member.groupId + '_' + member.uid
          && member.keys().hasOnly(['groupId', 'uid', 'joinedAt'])
          && member.joinedAt == request.time && exists(application)
          && get(application).data.groupId == member.groupId
          && get(application).data.studentUid == member.uid
          && get(application).data.status == 'pending';
      }
    }
    match /courseSets/{id} {
      allow get, list: if signedIn() && (role() == 'super_admin' || resource.data.visibility == 'public'
        || teachesGroup(resource.data.groupId) || isMember(resource.data.groupId));
      allow create: if teacher() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name','level','ownerUid','ownerName','visibility','groupId','words','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.words is list && request.resource.data.words.size() <= 150
        && ((request.resource.data.visibility == 'public' && request.resource.data.groupId == '')
          || (request.resource.data.visibility == 'group'
            && teachesGroup(request.resource.data.groupId)));
      allow delete: if signedIn() && (role() == 'super_admin' || resource.data.ownerUid == request.auth.uid);
    }
    function activityCount(value) {
      return value is int && value >= 0 && value <= 1000000000;
    }
    function validActivity() {
      let summary = request.resource.data;
      let days = summary.days;
      return summary.keys().hasOnly(['exercises','words','weekStart','days'])
        && activityCount(summary.exercises) && activityCount(summary.words)
        && summary.words <= summary.exercises
        && summary.weekStart is int && summary.weekStart >= 0 && summary.weekStart <= 100000
        && days is list && days.size() == 7
        && activityCount(days[0]) && activityCount(days[1]) && activityCount(days[2])
        && activityCount(days[3]) && activityCount(days[4]) && activityCount(days[5])
        && activityCount(days[6])
        && days[0] + days[1] + days[2] + days[3] + days[4] + days[5] + days[6] <= summary.exercises;
    }
    match /learningActivity/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || role() == 'super_admin');
      allow list: if role() == 'super_admin';
      allow create, update: if signedIn() && request.auth.uid == uid && validActivity();
    }
    match /personalProgress/{uid}/workspace/{itemId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind','key','payload','deleted'])
        && request.resource.data.kind in ['sets','custom','learningSessions','settings']
        && request.resource.data.key is string && request.resource.data.key.size() <= 300
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 700000
        && request.resource.data.deleted is bool;
    }
    match /personalProgress/{uid}/answers/{answerId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id','ok','mode','partial','errorType','at'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 300
        && request.resource.data.ok is bool
        && request.resource.data.mode in ['choice','typing','cards','recall']
        && request.resource.data.at is number
        && request.resource.data.errorType is string && request.resource.data.errorType.size() <= 80
        && request.resource.data.get('partial',false) is bool;
    }
    match /calendarEvents/{eventId} {
      allow get, list: if signedIn();
      allow create, update: if role() == 'super_admin'
        && request.resource.data.keys().hasOnly(['type','start','end','group','note'])
        && request.resource.data.type in ['cancel','holiday','move','extra','other']
        && request.resource.data.group in ['all','1','2']
        && request.resource.data.start is string && request.resource.data.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.end is string && request.resource.data.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.start <= request.resource.data.end
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000;
      allow delete: if role() == 'super_admin';
    }

    match /{document=**} { allow read, write: if false; }
  }
}
